      {
        "id": "requirement:config-image-pattern",
        "type": "requirement",
        "description": "Update the config schema reference example/default for fileTypes markup to include the new \"Image\" pattern that captures markdown image URLs via regex and triggers a saveScreenshot action with a directory param, matching samples/config.json."
      },
      {
        "id": "requirement:savescreenshot-directory",
        "type": "requirement",
        "description": "Confirm/expand saveScreenshot reference to document the directory param used by the new Image pattern (saving captured screenshots to a configured output directory)."
      },
      {
