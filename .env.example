# Copy to .env; never commit .env. Use ONLY a dedicated project database.
SHOPRESOLVE_DATABASE_URL=mysql+asyncmy://shopresolve:CHANGE_ME@127.0.0.1:13316/shopresolve
SHOPRESOLVE_DEMO_CODE=SET_A_LOCAL_DEMO_CODE
SHOPRESOLVE_ENABLE_DEMO=true
MYSQL_ROOT_PASSWORD=SET_A_LOCAL_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGE_ME
SHOPRESOLVE_REDIS_URL=redis://127.0.0.1:16379/0
SHOPRESOLVE_PROVIDER=demo
SHOPRESOLVE_MODEL=demo-v1
# Remote provider is opt-in. Never put real keys into this example.
SHOPRESOLVE_MODEL_BASE_URL=
SHOPRESOLVE_MODEL_API_KEY=
SHOPRESOLVE_ALLOW_PAID_MODEL=false
# Optional: install .[retrieval], run scripts/prepare_models.py, then use hybrid/reranker.
SHOPRESOLVE_RETRIEVAL_MODE=bm25
SHOPRESOLVE_ENABLE_RERANKER=false
SHOPRESOLVE_SANDBOX_TOKEN=
SHOPRESOLVE_SANDBOX_URL=http://127.0.0.1:18081
